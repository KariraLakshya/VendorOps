PORT=8001

# Required — no request to /recommend is accepted without this matching
# (fails closed). Must be the exact same value as the Node backend's
# AGENT_SERVICE_API_KEY. Generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AGENT_SERVICE_API_KEY=

# Required. Free tier: https://console.groq.com
GROQ_API_KEY=
# Verified live + tool-calling capable on Groq as of 2026-09-20.
GROQ_MODEL=openai/gpt-oss-120b

# Vision-capable model used as a fallback for scanned/image-based resumes.
# qwen/qwen3.8-27b (open-weight) verified live on Groq as of 2026-09-20 —
# accepts image content parts, correctly extracted fields from a rendered
# scanned-resume PDF through the real pipeline. Leave blank to make the
# vision path fail with a clear 422 instead of attempting a call.
GROQ_VISION_MODEL=qwen/qwen3.8-27b

AGENT_MAX_RETRIES=2
AGENT_TIMEOUT_MS=15000

# Extracted text below this many characters is treated as unreliable
# (likely scanned) and triggers the vision fallback instead.
OCR_MIN_TEXT_CHARS=40
# Max page/slide images sent to the vision model per resume.
OCR_MAX_IMAGES=5

LOG_LEVEL=INFO
