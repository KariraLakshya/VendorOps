NODE_ENV=development
PORT=5000

DATABASE_URL="postgresql://postgres:testrun@localhost:5445/zelosify_recruit_test?schema=public"

SESSION_SECRET=change-me

KEYCLOAK_URL=http://localhost:8080/auth
KEYCLOAK_REALM=Zelosify
KEYCLOAK_CLIENT_ID=dynamic-client
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_RS256_SIG=

# AES-256-GCM key for encrypting upload tokens — MUST be exactly 32 bytes
# (64 hex characters). Generate one (don't hand-type it — an off-by-one
# hex digit here has been a real, live-caught bug):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_ALGORITHM=aes-256-gcm
ENCRYPTION_KEY=

# Defaults point at the bundled MinIO container (docker-compose.yml).
# Leave S3_ENDPOINT blank and set real credentials to use actual AWS S3.
STORAGE_PROVIDER=aws
S3_AWS_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=zelosify-contract-uploads
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true

# AI Recommendation Agent runs as a separate Python/FastAPI service
# (see ../agent) — GROQ_API_KEY etc. live in its own .env
AGENT_SERVICE_URL=http://localhost:8001
AGENT_SERVICE_TIMEOUT_MS=20000
RECOMMENDATION_CONCURRENCY=4

# Must be the exact same value as the agent service's AGENT_SERVICE_API_KEY
# (it fails closed if either side leaves this unset). Generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AGENT_SERVICE_API_KEY=
